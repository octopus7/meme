# Copy to /etc/meme-origin/meme-origin.env, chmod 0600, and replace the token.
# Never commit the real environment file.
MEME_ORIGIN_HOST=127.0.0.1
MEME_ORIGIN_PORT=8086
MEME_ORIGIN_DATA_DIR=/var/lib/meme-origin
MEME_ORIGIN_ACCESS_LOG_DIR=/var/log/meme-origin
MEME_ORIGIN_MUTATION_TOKEN=replace-with-at-least-32-random-characters
MEME_ORIGIN_MAX_UPLOAD_BYTES=26214400
MEME_ORIGIN_MAX_IMAGE_PIXELS=80000000
MEME_ORIGIN_TRASH_RETENTION=30d
MEME_ORIGIN_PURGE_INTERVAL=1d
MEME_ORIGIN_REQUEST_TIMEOUT=2m
MEME_ORIGIN_SHUTDOWN_TIMEOUT=20s
MEME_ORIGIN_IMAGE_CONCURRENCY=1
