# /etc/meme-origin-dotnet/meme-origin-dotnet.env
LISTEN_URL=http://127.0.0.1:8087
DATA_DIR=/var/lib/meme-origin-dotnet
LOG_DIR=/var/log/meme-origin-dotnet
MUTATION_TOKEN=replace-with-at-least-32-random-characters
MAX_UPLOAD_BYTES=26214400
MAX_IMAGE_PIXELS=50000000
TRASH_RETENTION_DAYS=30
LOG_COMPRESSION_DAYS=30
