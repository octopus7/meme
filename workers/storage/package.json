{
  "name": "@meme/storage-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "wrangler types --config .wrangler.generated.jsonc src/worker-configuration.d.ts",
    "typecheck": "npm run types && tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && npm test && wrangler deploy --config .wrangler.generated.jsonc --dry-run --outdir dist",
    "deploy": "wrangler deploy --config .wrangler.generated.jsonc --keep-vars --minify"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  }
}
